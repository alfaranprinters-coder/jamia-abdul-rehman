    <!-- MadrassahDB Null-Safe Patch: Prevents crashes when IndexedDB unavailable on file:// -->
    <script>
        (function() {
            if (typeof MadrassahDB === 'undefined') return;

            // 1. Patch initDB — catch failures and add timeout so it never hangs on file://
            var origInitDB = MadrassahDB.initDB.bind(MadrassahDB);
            MadrassahDB.initDB = function() {
                if (this.db) return Promise.resolve(this.db);
                var timeoutPromise = new Promise(function(resolve) {
                    setTimeout(function() {
                        console.warn('[MMS] IndexedDB init timeout reached (1500ms). Continuing with safe fallback.');
                        resolve(MadrassahDB.db || null);
                    }, 1500);
                });
                return Promise.race([
                    origInitDB().then(function(realDb) {
                        MadrassahDB.db = realDb || MadrassahDB.db;
                        return MadrassahDB.db;
                    }).catch(function(err) {
                        console.warn('IndexedDB init failed (running in fallback mode):', err);
                        return MadrassahDB.db || null;
                    }),
                    timeoutPromise
                ]);
            };

            // 2. Patch ensureUniqueCodes — skip gracefully if db is null
            if (typeof MadrassahDB.ensureUniqueCodes === 'function') {
                var origEnsure = MadrassahDB.ensureUniqueCodes.bind(MadrassahDB);
                MadrassahDB.ensureUniqueCodes = function() {
                    if (!MadrassahDB.db) {
                        console.warn('ensureUniqueCodes skipped: db not ready');
                        return Promise.resolve();
                    }
                    return Promise.resolve().then(function() {
                        return origEnsure();
                    }).catch(function(e) {
                        console.warn('ensureUniqueCodes error (non-fatal):', e);
                    });
                };
            }

            // 3. Patch settings methods — skip if db null
            if (typeof MadrassahDB.getSetting === 'function') {
                var origGetSetting = MadrassahDB.getSetting.bind(MadrassahDB);
                MadrassahDB.getSetting = function() {
                    if (!MadrassahDB.db) return Promise.resolve(null);
                    return Promise.resolve().then(function() {
                        return origGetSetting.apply(MadrassahDB, arguments);
                    }).catch(function() { return null; });
                }.bind(MadrassahDB);
            }
            if (typeof MadrassahDB.setSetting === 'function') {
                var origSetSetting = MadrassahDB.setSetting.bind(MadrassahDB);
                MadrassahDB.setSetting = function() {
                    if (!MadrassahDB.db) return Promise.resolve();
                    return Promise.resolve().then(function() {
                        return origSetSetting.apply(MadrassahDB, arguments);
                    }).catch(function() {});
                }.bind(MadrassahDB);
            }
            if (typeof MadrassahDB.saveSetting === 'function') {
                var origSaveSetting = MadrassahDB.saveSetting.bind(MadrassahDB);
                MadrassahDB.saveSetting = function() {
                    if (!MadrassahDB.db) return Promise.resolve();
                    return Promise.resolve().then(function() {
                        return origSaveSetting.apply(MadrassahDB, arguments);
                    }).catch(function() {});
                }.bind(MadrassahDB);
            }

            // 4. Patch all getAll* and array-returning methods — return [] if db is null
            var safeEmpty = [
                'getAllStudents','getAllTeachers','getAllSyllabusBooks',
                'getAllStudentsAllSections','getAllReceipts','getAllExpenses',
                'getAllHifzStudents','getAllDonors','getAllGraduates',
                'getAllTimetableEntries','getAllClasses','getAllSubjects',
                'getStudentsBySection','getTeachersBySection','getAllBooks',
                'getAllFees','getStudentFees','getAllSalaries','getSalariesByMonth',
                'getStaffAdvances','getAllTransactions','getAttendance',
                'getAttendanceByMonth','getAttendanceByYear','getPersonAttendance',
                'getAllExams','getAllResults','getStudentResults','getExamResults',
                'getDonorDonations','getHifzDailyRecords','getHifzRevisions',
                'getHifzExams','getHifzExamResults','getHifzJuzProgress',
                'getHifzCompletions','getHifzHalaqas'
            ];
            safeEmpty.forEach(function(name) {
                if (typeof MadrassahDB[name] !== 'function') return;
                var orig = MadrassahDB[name].bind(MadrassahDB);
                MadrassahDB[name] = function() {
                    if (!MadrassahDB.db) return Promise.resolve([]);
                    return Promise.resolve().then(function() {
                        return orig.apply(MadrassahDB, arguments);
                    }).catch(function(e) {
                        console.warn(name + ' error (non-fatal):', e);
                        return [];
                    });
                }.bind(MadrassahDB);
            });

            // 5. Patch single-record getters — return null if db null
            var safeNull = [
                'getStudentById','getStudent','getTeacherById','getTeacher',
                'getReceipt','getExpense','getHifzStudent','getDonor',
                'getGraduate','getFeeById','getSalaryById','getAdvanceById',
                'getTransactionById','getExamById','getResultById',
                'getGraduateById','getDonorById','getHifzEnrollment'
            ];
            safeNull.forEach(function(name) {
                if (typeof MadrassahDB[name] !== 'function') return;
                var orig = MadrassahDB[name].bind(MadrassahDB);
                MadrassahDB[name] = function() {
                    if (!MadrassahDB.db) return Promise.resolve(null);
                    return Promise.resolve().then(function() {
                        return orig.apply(MadrassahDB, arguments);
                    }).catch(function() { return null; });
                }.bind(MadrassahDB);
            });

            // 6. Patch write methods (add/update/delete) — no-op if db null
            var safeWrite = [
                'saveStudent','addStudent','updateStudent','deleteStudent',
                'saveTeacher','addTeacher','updateTeacher','deleteTeacher',
                'saveSyllabusBook','addSyllabusBook','updateSyllabusBook','deleteSyllabusBook',
                'saveBook','deleteBook',
                'saveFee','deleteFee','addReceipt','updateReceipt','deleteReceipt',
                'saveSalary','saveAdvance','updateAdvanceStatus',
                'saveTransaction','deleteTransaction','deleteTransactionByReceipt',
                'addExpense','updateExpense','deleteExpense',
                'saveAttendance','saveAttendanceBatch',
                'saveExam','deleteExam','saveResult','deleteResult',
                'saveGraduate','deleteGraduate','addGraduate','updateGraduate',
                'saveDonor','deleteDonor','addDonor','updateDonor',
                'saveDonorDonation','deleteDonorDonation',
                'addHifzStudent','updateHifzStudent','deleteHifzStudent',
                'saveHifzDailyRecord','saveHifzRevision','saveHifzExam',
                'saveHifzExamResult','saveHifzJuzProgress','saveHifzCompletion'
            ];
            safeWrite.forEach(function(name) {
                if (typeof MadrassahDB[name] !== 'function') return;
                var orig = MadrassahDB[name].bind(MadrassahDB);
                MadrassahDB[name] = function() {
                    if (!MadrassahDB.db) return Promise.resolve();
                    return Promise.resolve().then(function() {
                        return orig.apply(MadrassahDB, arguments);
                    }).catch(function(e) {
                        console.warn(name + ' error:', e);
                    });
                }.bind(MadrassahDB);
            });

            console.log('[MMS] MadrassahDB null-safe patch applied.');
        })();
    </script>
