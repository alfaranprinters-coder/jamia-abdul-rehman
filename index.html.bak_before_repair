    <!-- MMS Final Bootstrap & Event Delegation -->
    <script>
    (function() {
        // 1. Capture real app instance if available
        if (window.app && typeof window.app.renderDashboard === 'function') {
            window._mmsRealApp = window.app;
            window.app.isAuthenticated = true;
        }

        // 2. Patch updateNavActiveState so it recognizes data-view and _nav
        if (typeof MadrassahApp !== 'undefined' && MadrassahApp.prototype) {
            MadrassahApp.prototype.updateNavActiveState = function() {
                var curr = this.currentView;
                document.querySelectorAll('.nav-link').forEach(function(link) {
                    var v = link.getAttribute('data-view');
                    if (!v) {
                        var onclick = link.getAttribute('onclick') || '';
                        var match = onclick.match(/navigate\(['"]([^'"]+)['"]\)/) || onclick.match(/_nav\(['"]([^'"]+)['"]\)/);
                        v = match ? match[1] : null;
                    }
                    var isActive = (v === curr);
                    link.classList.toggle('active', isActive);
                    if (isActive) {
                        var title = document.getElementById('mms-view-title');
                        var span = link.querySelector('span');
                        if (title && span) title.innerText = span.innerText;
                    }
                });
            };

            // Ensure navigate keeps auth true
            var _origNav = MadrassahApp.prototype.navigate;
            MadrassahApp.prototype.navigate = function(view) {
                this.isAuthenticated = true;
                return _origNav.call(this, view);
            };
        }

        // 3. Immediate and reliable display fix
        function fixDisplay() {
            var wel = document.getElementById('welcome-login-screen');
            var appEl = document.getElementById('app') || document.getElementById('mms-app-main');
            if (wel) wel.setAttribute('style', 'display: none !important;');
            if (appEl) appEl.setAttribute('style', 'display: flex !important;');
            var real = window._getApp();
            if (real) real.isAuthenticated = true;
        }
        fixDisplay();

        // 4. Capture-phase Click Delegation for 100% reliable Menu & Action Navigation
        document.addEventListener('click', function(e) {
            // A. Sidebar Nav Links
            var navLink = e.target.closest ? e.target.closest('.nav-link') : null;
            if (navLink) {
                var view = navLink.getAttribute('data-view');
                if (view) {
                    e.preventDefault();
                    e.stopPropagation();
                    window._nav(view);
                    return;
                }
                var onclick = navLink.getAttribute('onclick') || '';
                if (onclick.indexOf('logout') !== -1 || onclick.indexOf('_out') !== -1) {
                    e.preventDefault();
                    e.stopPropagation();
                    window._out();
                    return;
                }
            }

            // B. Section Switcher Tabs (بنین / بنات)
            var sectionTab = e.target.closest ? e.target.closest('.section-tabs .tab') : null;
            if (sectionTab) {
                var sec = sectionTab.getAttribute('data-section') || (sectionTab.innerText.indexOf('بنات') !== -1 ? 'banat' : 'banin');
                if (sec) {
                    e.preventDefault();
                    e.stopPropagation();
                    window._sec(sec);
                    return;
                }
            }

            // C. Sidebar Toggle Buttons
            var toggleBtn = e.target.closest ? (e.target.closest('#mms-sidebar-toggle') || e.target.closest('.sidebar-toggle-btn')) : null;
            if (toggleBtn) {
                e.preventDefault();
                e.stopPropagation();
                window._tog();
                return;
            }

            // D. Sidebar Overlay Backdrop
            if (e.target.id === 'mms-sidebar-overlay') {
                e.preventDefault();
                e.stopPropagation();
                window._tog(false);
                return;
            }

            // E. Action Buttons inside #main-content that call app.navigate('...')
            var quickBtn = e.target.closest ? e.target.closest('[onclick*="navigate"]') : null;
            if (quickBtn && !quickBtn.classList.contains('nav-link')) {
                var btnOnclick = quickBtn.getAttribute('onclick') || '';
                var match = btnOnclick.match(/navigate\(['"]([^'"]+)['"]\)/);
                if (match && match[1]) {
                    e.preventDefault();
                    e.stopPropagation();
                    window._nav(match[1]);
                    return;
                }
            }
        }, true);

        // 5. Initial Boot Verification: Ensure first view renders cleanly
        function ensureBooted() {
            fixDisplay();
            var real = window._getApp();
            if (real) {
                real.isAuthenticated = true;
                var mc = document.getElementById('main-content');
                if (mc && (!mc.children.length || mc.querySelector('.mms-spinner'))) {
                    real.currentView = real.currentView || 'dashboard';
                    if (typeof real.render === 'function') {
                        real.render();
                    }
                }
            } else {
                setTimeout(ensureBooted, 150);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', ensureBooted);
        } else {
            ensureBooted();
        }
        window.addEventListener('load', ensureBooted);
    })();

    window.forceOpenDashboard = function() {
        var a = window._getApp();
        if (a) {
            a.isAuthenticated = true;
            window._nav('dashboard');
        }
    };
    </script>

